NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
# DB_PATH=C:/path/to/private/symposium.db
# Set long, unrelated random values before deployment.
JWT_SECRET=
CERTIFICATE_SIGNING_KEY=

# Local demo is the default. Use razorpay with test keys before live keys.
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Required in production for verification and password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
